{
  "server_url": "https://hal-ai.it",
  "token": "INCOLLA-QUI-IL-TOKEN-DAL-TUO-ACCOUNT",
  "ingest_path": "/api/agent/ingest",
  "config_path": "/api/agent/config",
  "status_path": "/api/agent/status",
  "interval_minutes": 60,
  "days_limit": 7,
  "agents": [
    {
      "name": "Scout AI (fallback locale)",
      "keywords": [
        "intelligenza artificiale",
        "AI",
        "LLM"
      ],
      "rss_feeds": [
        "https://openai.com/blog/rss.xml"
      ],
      "reddit_subreddits": [
        "MachineLearning"
      ],
      "youtube_channels": [
        "@OpenAI"
      ]
    }
  ],
  "llm_bridge": {
    "enabled": false,
    "provider": "ollama",
    "endpoint": "http://localhost:11434",
    "model": "",
    "api_key": "",
    "poll_path": "/api/agent/jobs",
    "result_path": "/api/agent/jobs/result"
  },
  "transcripts": {
    "enabled": true,
    "poll_path": "/api/agent/transcribe",
    "poll_seconds": 60,
    "batch": 5,
    "fallback_rounds": 5
  },
  "video": {
    "enabled": false,
    "folder": "~/HAL/Video",
    "interval_minutes": 5,
    "agent_name": "Cartella video",
    "max_per_run": 20,
    "exts": [
      "txt",
      "md",
      "urls"
    ]
  }
}
